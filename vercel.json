{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },

    { "source": "/service-areas/aurora-co", "destination": "/aurora-junk-removal.html", "permanent": true },
    { "source": "/service-areas/littleton-co", "destination": "/littleton-junk-removal.html", "permanent": true },
    { "source": "/service-areas/thornton-co", "destination": "/thornton-junk-removal.html", "permanent": true },
    { "source": "/service-areas/englewood-co", "destination": "/englewood-junk-removal.html", "permanent": true },
    { "source": "/service-areas/arvada-co", "destination": "/arvada-junk-removal.html", "permanent": true },
    { "source": "/service-areas/parker-co", "destination": "/parker-junk-removal.html", "permanent": true },
    { "source": "/service-areas/castle-rock-co", "destination": "/castle-rock-junk-removal.html", "permanent": true },
    { "source": "/service-areas/all-surrounding-areas", "destination": "/#service-areas", "permanent": true },
    { "source": "/services/home-cleanouts", "destination": "/home-cleanouts.html", "permanent": true },
    { "source": "/services/office-junk-removal", "destination": "/office-junk-removal.html", "permanent": true },
    { "source": "/services/furniture-removal", "destination": "/furniture-removal.html", "permanent": true },
    { "source": "/services/yard-waste-removal", "destination": "/yard-waste-removal.html", "permanent": true },

    { "source": "/service-areas/denver-co", "destination": "/denver-junk-removal.html", "permanent": true },
    { "source": "/service-areas/lakewood-co", "destination": "/lakewood-junk-removal.html", "permanent": true },
    { "source": "/service-areas/westminster-co", "destination": "/westminster-junk-removal.html", "permanent": true },
    { "source": "/service-areas/broomfield-co", "destination": "/broomfield-junk-removal.html", "permanent": true },
    { "source": "/services/estate-cleanouts", "destination": "/estate-cleanouts.html", "permanent": true },
    { "source": "/services/electronics-recycling", "destination": "/electronics-recycling.html", "permanent": true },
    { "source": "/services/appliance-disposal", "destination": "/appliance-disposal.html", "permanent": true },
    { "source": "/services/dumpster-rental", "destination": "/dumpster-rental.html", "permanent": true },

    { "source": "/service-areas/highlands-ranch-co", "destination": "/highlands-ranch-junk-removal.html", "permanent": true },
    { "source": "/services/commercial-junk-removal", "destination": "/commercial-junk-removal.html", "permanent": true },
    { "source": "/services/storage-unit-cleanouts", "destination": "/storage-unit-cleanouts.html", "permanent": true },
    { "source": "/services/contractor-remodeler-junk-removal", "destination": "/contractor-remodeler-junk-removal.html", "permanent": true },
    { "source": "/services/property-management-junk-removal", "destination": "/property-management-junk-removal.html", "permanent": true },
    { "source": "/book", "destination": "/book/", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy", "permanent": true },
    { "source": "/admin", "destination": "/admin/", "permanent": true },
    { "source": "/admin/login", "destination": "/admin/login/", "permanent": true },
    { "source": "/admin/booking", "destination": "/admin/booking/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },

    { "source": "/api/admin/login", "destination": "/api/admin/auth?action=login" },
    { "source": "/api/admin/logout", "destination": "/api/admin/auth?action=logout" },
    { "source": "/api/admin/clients", "destination": "/api/admin/client?resource=list" }
  ],
  "crons": [
    { "path": "/api/admin/intake?action=cleanup-expired", "schedule": "0 9 * * *" }
  ],
  "functions": {
    "api/admin/bookings.js": {
      "includeFiles": "agent/**"
    }
  },
  "headers": [
    {
      "source": "/invoice/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://js.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; connect-src 'self' https://api.stripe.com; img-src 'self' data: https://*.stripe.com; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
